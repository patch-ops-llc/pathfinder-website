---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import RouteMotif from '../components/RouteMotif.astro';
import { site } from '../config/site.ts';

const links = [
  { label: 'Businesses', href: '/businesses/', icon: 'briefcase' },
  { label: 'Home and Auto', href: '/home-and-auto/', icon: 'home' },
  { label: 'Get a Quote', href: '/get-a-quote/', icon: 'file-text' },
  { label: 'Make a Payment', href: '/make-a-payment/', icon: 'credit-card' },
  { label: 'Our Team', href: '/our-team/', icon: 'users' },
  { label: 'Contact', href: '/contact/', icon: 'mail' },
];
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="surface-dark flex min-h-[70vh] items-center">
    <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="glow-orb -top-48 -left-40 -z-10 h-[30rem] w-[30rem] opacity-70" aria-hidden="true"></div>
    <RouteMotif class="absolute inset-0 -z-10 h-full w-full opacity-60" />
    <div class="container-page py-16 sm:py-24">
      <p class="eyebrow eyebrow-light">Error 404</p>
      <h1 class="mt-4 text-4xl sm:text-6xl">You’ve wandered off the path.</h1>
      <p class="mt-5 max-w-xl text-lg text-slate-300">We couldn’t find that page. It may have moved. Try one of these, or call us at <a href={`tel:${site.phone.tel}`} class="font-semibold text-white underline underline-offset-4">{site.phone.display}</a>.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-light">Back to home <Icon name="arrow-right" size={16} class="arrow" /></a>
      </div>
      <ul class="mt-10 grid max-w-3xl gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="group flex min-h-14 items-center gap-3 rounded-2xl border border-white/15 bg-white/5 px-4 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:border-white/40 hover:bg-white/10">
                <Icon name={l.icon} size={18} class="text-glow" />
                <span class="flex-1">{l.label}</span>
                <Icon name="arrow-right" size={14} class="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
