---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import LeadSection from '../components/LeadSection.astro';
import PageHero from '../components/PageHero.astro';
import { img } from '../content/images.ts';
import { lines, type Line } from '../content/lines.ts';
import { faqSchema, serviceSchema, webPageSchema, type Crumb } from '../lib/seo.ts';

export function getStaticPaths() {
  return lines.map((line) => ({ params: { line: line.path.replaceAll('/', '') }, props: { line } }));
}

interface Props {
  line: Line;
}
const { line } = Astro.props;
const base = Astro.site!;
const hub = line.group === 'business' ? { name: 'Businesses', path: '/businesses/' } : { name: 'Home and Auto', path: '/home-and-auto/' };
const crumbs: Crumb[] = [{ name: 'Home', path: '/' }, hub, { name: line.heading, path: line.path }];
const others = lines.filter((l) => l.group === line.group && l.slug !== line.slug);
const hasBodies = line.features.some((f) => f.body);
const cols = line.features.length >= 5 ? 'sm:grid-cols-2 lg:grid-cols-3' : line.features.length === 4 ? 'sm:grid-cols-2' : 'md:grid-cols-3';
const jsonLd = [
  webPageSchema(base, { path: line.path, title: line.title, description: line.metaDescription }),
  serviceSchema(base, line),
  faqSchema(line.faqs),
];
---

<BaseLayout title={line.title} description={line.metaDescription} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <PageHero
    eyebrow={line.group === 'business' ? 'We guide businesses' : 'We guide people'}
    title={line.heading}
    lead={line.intro}
    crumbs={crumbs}
    image={img(`lines/${line.cardImage}`)}
    imageAlt={line.imageAlt}
  >
    <a href="#lets-talk" class="btn btn-light">Let’s talk <Icon name="arrow-right" size={16} class="arrow" /></a>
    {line.cta?.map((c) => <a href={c.href} class="btn btn-ghost">{c.label} <Icon name="arrow-right" size={16} class="arrow" /></a>)}
  </PageHero>

  <section class="relative py-16 sm:py-20 lg:py-28" aria-labelledby="coverage-heading">
    <div class="bg-dots absolute inset-x-0 top-0 -z-10 h-72" aria-hidden="true"></div>
    <div class="container-page">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{line.name}</p>
        <h2 id="coverage-heading" class="mt-4 text-3xl sm:text-4xl lg:text-[2.75rem]">{hasBodies ? 'How we guide you' : 'What we cover'}</h2>
      </div>
      <ul class:list={['mt-12 grid gap-6', cols]}>
        {
          line.features.map((f, i) => (
            <li class="card hover:shadow-lift hover:border-brand-200 relative overflow-hidden p-7 transition duration-500 hover:-translate-y-1" data-reveal style={`--reveal-i:${i % 3}`}>
              <span class="from-brand-700 to-brand-500 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br text-white shadow-[0_12px_28px_-10px_rgb(0_81_160/0.7)]">
                <Icon name={f.icon} size={26} />
              </span>
              <h3 class="mt-6 text-xl">{f.title}</h3>
              {f.body && <p class="mt-3 text-[0.95rem] leading-7 text-slate-600">{f.body}</p>}
              <span class="text-brand-100 pointer-events-none absolute -top-3 right-4 text-7xl font-bold tabular-nums select-none" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    line.heroImage !== line.cardImage && (
      <section class="container-page pb-16 sm:pb-20 lg:pb-28" aria-label={`${line.name} in pictures`}>
        <div class="relative overflow-hidden rounded-[2rem]" data-reveal="scale">
          <Picture
            src={img(`lines/${line.heroImage}`)}
            alt=""
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1280px) 1216px, calc(100vw - 2.5rem)"
            quality={55}
            loading="lazy"
            class="aspect-[4/3] w-full object-cover sm:aspect-[21/9]"
          />
          <div class="from-brand-950/85 via-brand-950/35 absolute inset-0 bg-gradient-to-r to-transparent" aria-hidden="true" />
          <div class="absolute inset-0 flex items-end p-6 sm:items-center sm:p-12">
            <div class="max-w-md">
              <p class="text-2xl leading-tight font-bold text-white sm:text-4xl">{line.formHeading}.</p>
              <a href="#lets-talk" class="btn btn-light mt-6">Let’s talk <Icon name="arrow-right" size={16} class="arrow" /></a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <Faq faqs={line.faqs} heading={`${line.name}: common questions`} />

  <LeadSection formId={line.formId} heading={line.formHeading} />

  <section class="py-16 sm:py-20" aria-labelledby="more-heading">
    <div class="container-page">
      <h2 id="more-heading" class="text-2xl sm:text-3xl">{line.group === 'business' ? 'More coverage for businesses' : 'More coverage for people'}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          others.map((o) => (
            <li>
              <a href={o.path} class="group card hover:border-brand-300 hover:shadow-lift flex min-h-16 items-center gap-4 px-5 py-4 transition duration-300">
                <span class="bg-brand-50 text-brand-700 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl"><Icon name={o.icon} size={20} /></span>
                <span class="text-ink flex-1 font-semibold">{o.heading}</span>
                <Icon name="arrow-right" size={16} class="arrow text-brand-600" />
              </a>
            </li>
          ))
        }
        {
          line.group === 'personal' && (
            <li>
              <a href="/get-a-quote/" class="group card hover:border-brand-300 hover:shadow-lift flex min-h-16 items-center gap-4 px-5 py-4 transition duration-300">
                <span class="bg-brand-50 text-brand-700 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl"><Icon name="file-text" size={20} /></span>
                <span class="text-ink flex-1 font-semibold">Get a Quote</span>
                <Icon name="arrow-right" size={16} class="arrow text-brand-600" />
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </section>
</BaseLayout>
