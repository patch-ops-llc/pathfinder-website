---
import Icon from './Icon.astro';
import { site } from '../config/site.ts';
interface Props {
  heading?: string;
  text?: string;
}
const { heading = 'Find your path.', text = 'Talk with a Pathfinder/LL&D guide about coverage for your business, your home or your collection.' } = Astro.props;
---

<section class="container-page py-16 sm:py-20">
  <div class="surface-dark rounded-[2rem] px-6 py-12 sm:px-12 sm:py-16" data-reveal="scale">
    <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="glow-orb -top-32 -right-24 -z-10 h-80 w-80" aria-hidden="true"></div>
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl">{heading}</h2>
        <p class="mt-3 max-w-xl text-slate-300">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/get-a-quote/" class="btn btn-light">Get a quote <Icon name="arrow-right" size={16} class="arrow" /></a>
        <a href={`tel:${site.phone.tel}`} class="btn btn-ghost"><Icon name="phone" size={16} /> {site.phone.display}</a>
      </div>
    </div>
  </div>
</section>
