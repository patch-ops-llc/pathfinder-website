---
import { Image } from 'astro:assets';
import logoMono from '../assets/brand/logo-mono.png';
import Icon from './Icon.astro';
import { nav, site } from '../config/site.ts';

const year = new Date().getFullYear();
const company = [
  { label: 'Our Team', href: '/our-team/' },
  { label: 'Careers', href: '/careers/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Resources', href: '/resources/' },
  { label: 'Make a Payment', href: '/make-a-payment/' },
  { label: 'Get a Quote', href: '/get-a-quote/' },
];
const columns = [
  { heading: 'Businesses', href: '/businesses/', items: nav[0].items },
  { heading: 'Home and Auto', href: '/home-and-auto/', items: nav[1].items },
  { heading: 'Company', href: undefined, items: company },
];
---

<footer class="surface-dark mt-auto">
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="glow-orb -top-40 -right-32 -z-10 h-96 w-96 opacity-60" aria-hidden="true"></div>

  <div class="container-page py-14 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_2fr]">
      <div>
        <a href="/" class="inline-block" aria-label={`${site.name} home`}>
          <Image src={logoMono} alt={site.name} width={230} height={52} widths={[230, 460]} sizes="230px" loading="lazy" class="h-12 w-auto" />
        </a>
        <p class="mt-6 max-w-sm text-sm leading-6 text-slate-400">
          Insurance guides since {site.foundingYear}. We got our start in Texas, but we serve people and businesses across the country.
        </p>
        <address class="mt-6 space-y-3 text-sm not-italic">
          <a href={site.mapUrl} target="_blank" rel="noopener" class="group flex items-start gap-3 text-slate-300 hover:text-white">
            <Icon name="map-pin" size={18} class="text-glow mt-0.5 shrink-0" />
            <span>
              {site.address.street}<br />
              {site.address.city}, {site.address.region} {site.address.postalCode}
            </span>
          </a>
          <a href={`tel:${site.phone.tel}`} class="flex items-center gap-3 text-slate-300 hover:text-white">
            <Icon name="phone" size={18} class="text-glow shrink-0" />
            {site.phone.display}
          </a>
        </address>
        <div class="mt-6 flex gap-3">
          <a
            href={site.social.linkedin}
            target="_blank"
            rel="noopener"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 text-slate-300 transition hover:border-white/40 hover:bg-white/10 hover:text-white"
            aria-label="Pathfinder/LL&D on LinkedIn"
          >
            <Icon name="linkedin" size={17} />
          </a>
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 text-slate-300 transition hover:border-white/40 hover:bg-white/10 hover:text-white"
            aria-label="Pathfinder/LL&D on Facebook"
          >
            <Icon name="facebook" size={17} />
          </a>
        </div>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3">
        {
          columns.map((col) => (
            <div>
              <h2 class="text-xs font-bold tracking-[0.18em] text-white uppercase">
                {col.href ? <a href={col.href} class="hover:text-glow">{col.heading}</a> : col.heading}
              </h2>
              <ul class="mt-4 space-y-1">
                {col.items.map((item) => (
                  <li>
                    <a href={item.href} class="inline-flex min-h-9 items-center text-sm text-slate-400 transition-colors hover:text-white">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs text-slate-400 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={site.incidentNotice.href} class="inline-flex min-h-8 items-center hover:text-white">{site.incidentNotice.label}</a></li>
        <li><a href="/attribution/" class="inline-flex min-h-8 items-center hover:text-white">Attribution</a></li>
        <li><a href="/sitemap.xml" class="inline-flex min-h-8 items-center hover:text-white">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>
