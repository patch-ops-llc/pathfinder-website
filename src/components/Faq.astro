---
import type { Faq } from '../content/lines.ts';
import Icon from './Icon.astro';

interface Props {
  faqs: Faq[];
  heading?: string;
  eyebrow?: string;
}
const { faqs, heading = 'Common questions', eyebrow = 'FAQ' } = Astro.props;
---

<section class="bg-mist py-16 sm:py-20 lg:py-24" aria-labelledby="faq-heading">
  <div class="container-page grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="faq-heading" class="mt-4 text-3xl sm:text-4xl">{heading}</h2>
      <p class="mt-4 max-w-sm text-slate-600">
        Have a different question? <a href="/contact/" class="text-brand-700 font-semibold underline underline-offset-4">Talk to our team</a>.
      </p>
    </div>
    <div class="space-y-3">
      {
        faqs.map((f, i) => (
          <details class="group card overflow-hidden" data-reveal style={`--reveal-i:${i}`} name="faq">
            <summary class="text-ink flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-base font-semibold sm:px-6">
              <h3 class="text-base font-semibold tracking-normal">{f.q}</h3>
              <span class="bg-brand-50 text-brand-700 flex h-8 w-8 shrink-0 items-center justify-center rounded-full transition-transform duration-300 group-open:rotate-45">
                <Icon name="plus" size={16} />
              </span>
            </summary>
            <div class="px-5 pb-5 text-[0.95rem] leading-7 text-slate-600 sm:px-6">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
