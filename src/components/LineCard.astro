---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { img } from '../content/images.ts';
import type { Line } from '../content/lines.ts';

interface Props {
  line: Line;
  index?: number;
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
}
const { line, index = 0, headingLevel: H = 'h3', sizes = '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw' } = Astro.props;
---

<article class="group card relative flex h-full flex-col overflow-hidden transition duration-500 hover:-translate-y-1 hover:shadow-lift" data-reveal style={`--reveal-i:${index % 3}`}>
  <div class="relative overflow-hidden">
    <Picture
      src={img(`lines/${line.cardImage}`)}
      alt={line.imageAlt}
      formats={['avif', 'webp']}
      widths={[360, 540, 800]}
      sizes={sizes}
      quality={58}
      loading="lazy"
      class="aspect-[16/10] w-full object-cover transition duration-700 ease-out group-hover:scale-105"
    />
    <div class="from-brand-950/70 absolute inset-0 bg-gradient-to-t via-transparent to-transparent" aria-hidden="true"></div>
    <span class="text-brand-700 absolute bottom-4 left-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white shadow-lg">
      <Icon name={line.icon} size={20} />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <H class="text-xl">
      <a href={line.path} class="after:absolute after:inset-0 focus-visible:outline-none">
        {line.name}
      </a>
    </H>
    <p class="mt-3 flex-1 text-[0.95rem] leading-6 text-slate-600">{line.blurb}</p>
    <span class="text-brand-700 mt-5 inline-flex items-center gap-2 text-sm font-semibold">
      Learn more
      <Icon name="arrow-right" size={16} class="arrow transition-transform duration-300" />
    </span>
  </div>
</article>
