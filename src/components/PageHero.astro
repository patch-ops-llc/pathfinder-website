---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import RouteMotif from './RouteMotif.astro';
import type { Crumb } from '../lib/seo.ts';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Narrow heroes centre their text and omit the image. */
  compact?: boolean;
}
const { eyebrow, title, lead, crumbs, image, imageAlt = '', compact = false } = Astro.props;
---

<section class="surface-dark">
  <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="glow-orb -top-48 -left-40 -z-10 h-[30rem] w-[30rem] opacity-70" aria-hidden="true"></div>
  <RouteMotif class="absolute inset-0 -z-10 h-full w-full opacity-60" />

  <div class:list={['container-page', compact ? 'py-12 sm:py-16 lg:py-20' : 'py-12 sm:py-16 lg:py-24']}>
    {crumbs && crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
    <div class:list={['mt-6 grid items-center gap-10 lg:gap-16', image && !compact ? 'lg:grid-cols-[1.05fr_0.95fr]' : '']}>
      <div class:list={[compact || !image ? 'max-w-3xl' : '']}>
        {eyebrow && <p class="eyebrow eyebrow-light">{eyebrow}</p>}
        <h1 class="mt-4 text-4xl leading-[1.08] sm:text-5xl lg:text-[3.5rem]">{title}</h1>
        {lead && <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg sm:leading-8">{lead}</p>}
        {
          Astro.slots.has('default') && (
            <div class="mt-8 flex flex-wrap gap-3">
              <slot />
            </div>
          )
        }
      </div>
      {
        image && !compact && (
          <div class="relative" data-reveal="scale">
            <div class="from-glow/40 to-brand-600/0 absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br blur-2xl" aria-hidden="true" />
            <Picture
              src={image}
              alt={imageAlt}
              formats={['avif', 'webp']}
              widths={[400, 640, 800, 1100]}
              sizes="(min-width: 1024px) 560px, 100vw"
              loading="eager"
              fetchpriority="high"
              quality={62}
              class="aspect-[4/3] w-full rounded-[1.5rem] border border-white/15 object-cover shadow-2xl"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
