# Pathfinder/LL&D website: environment variables.
#
# Local development: copy this file to .env. Every value is optional locally;
# with nothing set, forms still work end to end and each alert email is written
# to .data/outbox/ instead of being sent.
#
# Production (Railway): set these as service variables. Never commit real values.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public address of the site, no trailing slash. Used for canonical links, the
# sitemap, structured data and the form origin check. Also needed at BUILD time
# (Railway passes service variables to the Docker build as the SITE_URL arg).
SITE_URL=https://www.pathfinderlld.com

# Optional. Extra origins allowed to post forms, comma separated. Add the
# Railway-provided domain while the custom domain is not live yet,
# e.g. https://pathfinder-website-production.up.railway.app
ALLOWED_ORIGINS=

# Optional. When set, requests for the other www / non-www variant of this host
# are redirected to it, e.g. www.pathfinderlld.com
CANONICAL_HOST=

# Set by Railway automatically. Locally the server uses 4321.
# PORT=4321

# ---------------------------------------------------------------------------
# Email alerts (Resend)
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com/api-keys). A "Sending access" key is enough.
# Required in production. Without it no alert can be sent: the quote, careers
# and check draft forms refuse the submission with a "please call us" message
# (rather than accept it and lose it), and the "Let's Talk" forms are accepted
# only when HubSpot received them.
RESEND_API_KEY=

# From address. The domain must be verified in Resend (DNS records for SPF and
# DKIM). Example: Pathfinder Website <website@pathfinderlld.com>
EMAIL_FROM=

# Who receives form alerts. Comma separated. Required in production.
ALERT_EMAIL_TO=

# Optional. Copied on every alert.
ALERT_EMAIL_CC=

# Optional. Per-form recipients that replace ALERT_EMAIL_TO for one form.
# ALERT_EMAIL_TO_LEAD_ENERGY=
# ALERT_EMAIL_TO_LEAD_CONTRACTORS=
# ALERT_EMAIL_TO_LEAD_EMPLOYEE_BENEFITS=
# ALERT_EMAIL_TO_LEAD_PROFESSIONAL_SERVICES=
# ALERT_EMAIL_TO_LEAD_REAL_ESTATE=
# ALERT_EMAIL_TO_LEAD_NON_PROFIT=
# ALERT_EMAIL_TO_LEAD_COLLECTIONS=
# ALERT_EMAIL_TO_LEAD_HOME_AUTO=
# ALERT_EMAIL_TO_LEAD_CONTACT=
# ALERT_EMAIL_TO_HOME_QUOTE=
# ALERT_EMAIL_TO_AUTO_QUOTE=
# ALERT_EMAIL_TO_PL_QUOTE=
# ALERT_EMAIL_TO_CAREERS=
# ALERT_EMAIL_TO_CHECK_DRAFT=

# Optional. "console" forces the development sender (alerts are written to
# .data/outbox/ locally and only logged in production). Leave empty to use
# Resend whenever RESEND_API_KEY is set.
EMAIL_PROVIDER=

# ---------------------------------------------------------------------------
# HubSpot
# ---------------------------------------------------------------------------

# Submissions go to HubSpot only when this is "true". It is off by default so
# local and preview environments never write to the live CRM.
HUBSPOT_ENABLED=false

# HubSpot account (portal) ID. The current site uses 3806082.
HUBSPOT_PORTAL_ID=3806082

# Optional. Contact property that receives the readable summary of the longer
# forms (quotes, careers, check draft). Sensitive answers are never included.
HUBSPOT_SUMMARY_PROPERTY=message

# Optional. HubSpot form GUID per website form. The six "Let's Talk" forms
# default to the GUIDs already used on the current site; the home and auto
# quotes default to the Home and Auto "Let's Talk" form and the professional
# liability quote to the Professional Services one. Careers and check draft
# have no HubSpot form until a GUID is set here.
# HUBSPOT_FORM_LEAD_ENERGY=
# HUBSPOT_FORM_LEAD_CONTRACTORS=
# HUBSPOT_FORM_LEAD_EMPLOYEE_BENEFITS=
# HUBSPOT_FORM_LEAD_PROFESSIONAL_SERVICES=
# HUBSPOT_FORM_LEAD_REAL_ESTATE=
# HUBSPOT_FORM_LEAD_NON_PROFIT=
# HUBSPOT_FORM_LEAD_COLLECTIONS=
# HUBSPOT_FORM_LEAD_HOME_AUTO=
# HUBSPOT_FORM_LEAD_CONTACT=
# HUBSPOT_FORM_HOME_QUOTE=
# HUBSPOT_FORM_AUTO_QUOTE=
# HUBSPOT_FORM_PL_QUOTE=
# HUBSPOT_FORM_CAREERS=
# HUBSPOT_FORM_CHECK_DRAFT=

# ---------------------------------------------------------------------------
# Optional webhook
# ---------------------------------------------------------------------------

# Every accepted submission is also POSTed here as JSON (sensitive answers and
# attachments removed). Use it for a HubSpot workflow webhook, Zapier, Make, etc.
SUBMISSION_WEBHOOK_URL=

# When set, each webhook request carries an HMAC-SHA256 signature of the body
# in the X-Pathfinder-Signature header ("sha256=<hex>").
SUBMISSION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Spam and abuse protection
# ---------------------------------------------------------------------------

# Secret used to sign form tokens. Required in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_TOKEN_SECRET=

# Optional. Cloudflare Turnstile keys. When both are set, every form shows the
# Turnstile check and the server verifies it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. Submissions allowed per visitor IP per window. Defaults: 10 per 600 s.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_SECONDS=

# Optional. Read the visitor IP from proxy headers (default true; Railway sits
# behind a proxy). Set to false only when the server is exposed directly.
TRUST_PROXY=

# Optional. Redirect plain-HTTP requests to HTTPS in production (default true).
FORCE_HTTPS=
